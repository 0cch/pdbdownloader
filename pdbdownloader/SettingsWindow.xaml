<Window x:Class="pdbdownloader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="610"
        Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBrush}">
            <StackPanel VerticalAlignment="Center" Margin="22,0">
                <TextBlock Text="Settings" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Configure symbol storage and download behavior" Foreground="{StaticResource HeaderMutedBrush}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SYMBOL DIRECTORY" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SymbolPathTextBox" Style="{StaticResource FormTextBoxStyle}" />
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click" />
                        </Grid>
                        <TextBlock Text="Downloaded files are stored using the standard symbol server directory layout." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SYMBOL SERVER" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBox x:Name="SymbolServerTextBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,7,0,0" />
                        <TextBlock Text="Use a Microsoft-compatible symbol server root. Authentication is not supported yet." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="DOWNLOAD BEHAVIOR" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Timeout (seconds)" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                <TextBox x:Name="TimeoutTextBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Retry attempts" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                <TextBox x:Name="RetryTextBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Parallel downloads" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                <TextBox x:Name="ConcurrencyTextBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Allowed ranges: timeout 5–3600 seconds, retries 1–10, parallel downloads 1–8." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationText" Foreground="{StaticResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="2,12,2,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Settings are stored per Windows user." VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" />
                <Button Grid.Column="3" Content="Save settings" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>